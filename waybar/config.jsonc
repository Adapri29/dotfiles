[

    {
        "name": "full-bar-horizontal",
        "output": ["HDMI-A-2"], // main monitors
        "layer": "top",
        "position": "top",
        "height": 10,
        "spacing": 0,
        "reload_style_on_change": true,

        "modules-left": [
		"custom/launcher",
		"custom/notifications",
        	"hyprland/workspaces",
	],

        "modules-center": [
		"custom/weather",
		"clock"
        ],

        "modules-right": [
		"mpris",
		"privacy",
		"tray",
		"custom/updates",
		"disk",
		"custom/notification",
		"network",
		"bluetooth",
		"pulseaudio",
		"custom/wallpaper",
		"custom/power",
		"hyprland/languaje"


	   //"network#wifi",
	   // "bluetooth",
	   // "pulseaudio",
           // "clock",
	    //"custom/power"
        ],

        // Left modules
        "custom/launcher": {
            "format": "",
            "tooltip-format": "<b><span color='#fab387'><big> App Launcher</big></span></b>\n<span color='#cdd6f4'>Open app launcher</span>",
            "on-click": "walker"
        },

	"custom/notifications": {
		"exec": "swaync-client -swb",
		"return-type": "json",
		"exec-if": "which swaync-client",
		"format": "{icon}",
		"format-icons": {
			"none": "󰂜",
    			"notification": "󰂜<span foreground='red'><sup>●</sup></span>",
    			"dnd-none": "󰂛",
    			"dnd-notification": "󰂛<span foreground='red'><sup>●</sup></span>",
    			"inhibited-none": "󰂜",
    			"inhibited-notification": "󰂜<span foreground='red'><sup>●</sup></span>",
    			"dnd-inhibited-none": "󰂛",
    			"dnd-inhibited-notification": "󰂛<span foreground='red'><sup>●</sup></span>"
		},
		"tooltip": false,
		"on-click": "sleep 0.1 && swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"on-click-middle": "swaync-client -C",
		"escape": true
	},

        "custom/wallpaper": {
	    "exec": "ls ~/Imágenes/Wallpapers | wc -l",
            "format": "",
	    "tooltip-format": "<b><span color='#fab387'><big> Wallpaper</big></span></b>\n<span color='#cdd6f4'>Pick from {} wallpapers</span>",
            "on-click": "walker -m menus -p wallpapers"
        },

        // Center modules
        "mpris": {
            "format": "{player_icon}",
            "format-paused": "{status_icon}",
            "player-icons": {
                "default": "",
                "mpv": ""
            },
            "status-icons": {
                "paused": ""
            },
            "tooltip-format": " {player}\n {artist}\n {album} {title}\n [{position}/{length}]"
        },

        "hyprland/workspaces": {
            "format": "{name}",
            "on-click": "activate",
            "on-scroll-up": "~/.config/waybar/scripts/workspace-scroll.sh up",
            "on-scroll-down": "~/.config/waybar/scripts/workspace-scroll.sh down",
            "all-outputs": false,
            "persistent-workspaces": {
                "HDMI-A-2": [1, 2, 3, 4, 5]	
	    }
        },
        

        "clock": {
            "format": "{:%Y/%m/%d  %H:%M:%S}",
            "on-click": "kitty --class floating --title 'Calendar' -e calcurse",
            "tooltip-format": "<b><span color='#fab387'><big> Calendar (󰳽 Launch Calcurse)</big></span></b>\n<tt>{calendar}</tt>",
            "calendar": {
                "mode"          : "year",
                "mode-mon-col"  : 3,
                "weeks-pos"     : "right",
                "on-scroll"     : 1,
                "on-click-right": "mode",
                "format": {
                    "months":     "<span color='#f9e2af'><b>{}</b></span>",
                    "days":       "<span color='#cdd6f4'><b>{}</b></span>",
                    "weeks":      "<span color='#a6e3a1'><b>W{}</b></span>",
                    "weekdays":   "<span color='#fab387'><b>{}</b></span>",
                    "today":      "<span color='#f38ba8'><b><u>{}</u></b></span>"
                }
            },
            "interval": 1
        },

        "custom/weather": {
            "exec": "~/.config/waybar/scripts/weather.sh 0",
            "return-type": "json",
            "interval": 1800,
            "format": "{}",
            "on-click": "~/.config/waybar/scripts/weather.sh toggle",
            "signal": 8
        },

        "network#ethernet": {
            "interface": "e*",
            "format-ethernet": " ",
            "format-disconnected": "",
            "tooltip-format-ethernet": "<b><span color='#fab387'><big>󰈀 Connected to Ethernet</big></span></b>\n<span color='#89dceb'>IP:</span> <span color='#cdd6f4'>{ipaddr}</span>\n<span color='#89dceb'>Interface:</span> <span color='#cdd6f4'>{ifname}</span>\n<b><span color='#fab387'><big>󰛳 Network</big></span></b>\n<span color='#89dceb'>Down:</span> <span color='#cdd6f4'>{bandwidthDownBits}</span>\n<span color='#89dceb'>Up:</span> <span color='#cdd6f4'>{bandwidthUpBits}</span>",
            "tooltip-disconnected": "<b><span color='#fab387'><big>󰤭 Network</big></span></b>\n<span color='#f38ba8'>Disconnected</span>",
            "on-click": "walker -m menus:wifi"
        },
        "network#wifi": {
            "interface": "w*",
            "format-wifi": "󰤨",
            "format-disconnected": "󰤭",
            "tooltip-format-wifi": "<b><span color='#fab387'><big>󰤨 Connected to Wifi</big></span></b>\n<span color='#89dceb'>IP:</span> <span color='#cdd6f4'>{ipaddr}</span>\n<span color='#89dceb'>Wifi:</span> <span color='#cdd6f4'>{essid} ({signalStrength}%)</span>\n<b><span color='#fab387'><big>󰛳 Network</big></span></b>\n<span color='#89dceb'>Down:</span> <span color='#cdd6f4'>{bandwidthDownBits}</span>\n<span color='#89dceb'>Up:</span> <span color='#cdd6f4'>{bandwidthUpBits}</span>",
            "tooltip-disconnected": "<b><span color='#fab387'><big>󰤭 Network</big></span></b>\n<span color='#f38ba8'>Disconnected</span>",
            "on-click": "walker -m menus:wifi"
        },

        "bluetooth": {
            "format": "",
            "format-off": "󰂲",
            "format-disabled": "",
            "format-connected": " {num_connections}",
            "tooltip-format": "<b><span color='#fab387'><big> Bluetooth</big></span></b>\n<span color='#89dceb'>Status:</span> <span color='#cdd6f4'>{status}</span>\n<span color='#89dceb'>Controller:</span> <span color='#cdd6f4'>{controller_alias}</span>",
            "tooltip-format-connected": "<b><span color='#fab387'><big> Connected ({num_connections})</big></span></b>\n<span color='#89dceb'>Controller:</span> <span color='#cdd6f4'>{controller_alias}</span>\n\n<b><span color='#fab387'><big>󰂱 Devices</big></span></b>\n<span color='#cdd6f4'>{device_enumerate}</span>",
            "tooltip-format-enumerate-connected": "<span color='#89dceb'>󰂄</span> {device_alias}",
            "tooltip-format-enumerate-connected-battery": "<span color='#89dceb'>󰂄</span> {device_alias} <span color='#a6e3a1'>({device_battery_percentage}%)</span>",
            "on-click": "blueman-manager"
        },

        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟 Muted",
            "format-icons": {
                "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
                "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
                "headphone": "",
                "hands-free": "",
                "headset": "",
                "phone": "",
                "phone-muted": "",
                "portable": "",
                "car": "",
                "default": ["", ""]
            },
            "on-click": "hyprctl dispatch exec pwvucontrol",
            "tooltip-format": "<b><span color='#fab387'><big>󰕾 Audio</big></span></b>\n<span color='#89dceb'>Volume:</span> <span color='#cdd6f4'>{volume}%</span>"
        },

	"custom/power": {
	    "format": "⏻",
	    "on-click": "wlogout -b 5", 
	    "tooltip": false
	},

	"tray":{
		"icon-size": 24,
		"spacing": 10,
		"show-passive-items": false
	}

	
    }
]
